# Dockerfile.vercel — Deploy do OPR Multas App na Vercel (Fluid Compute)
# Builda o Spring Boot e roda o jar ouvindo na porta fornecida por $PORT.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY backend/pom.xml ./
RUN mvn -q -B dependency:go-offline
COPY backend/src ./src
RUN mvn -q -B package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

# Perfil de produção (PostgreSQL/Supabase). Pode ser sobrescrito via env na Vercel.
ENV SPRING_PROFILES_ACTIVE=prod

# Heap limitado e previsível: evita que a JVM reivindique memória demais do
# container (Vercel) e seja morta por OOM no cold-start. Heap é commitado
# lazy; 512m é folgado para este app e sobra RAM para metaspace/threads.
ENV JAVA_TOOL_OPTIONS="-Xmx512m"

# Vercel injeta a variável PORT em tempo de execução
EXPOSE 8080

RUN addgroup --system app && adduser --system --ingroup app app
USER app

CMD ["sh", "-c", "exec java -jar app.jar"]
