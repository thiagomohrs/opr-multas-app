# Dockerfile.vercel — Deploy do OPR Multas App na Vercel (Fluid Compute)
# Builda o Spring Boot e roda o jar ouvindo na porta fornecida por $PORT.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY backend/pom.xml ./
RUN mvn -q -B dependency:go-offline
COPY backend/src ./src
RUN mvn -q -B package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

# Perfil de produção (PostgreSQL/Supabase). Pode ser sobrescrito via env na Vercel.
ENV SPRING_PROFILES_ACTIVE=prod

# Heap limitado e previsível: o Fluid Compute da Vercel por padrão dá ~512MB ao
# container. Heap + metaspace + code cache + threads NÃO podem estourar isso, ou o
# kernel mata o processo no cold-start (INTERNAL_FUNCTION_INVOCATION_FAILED).
# SerialGC: pouquíssima memória overhead e boot mais rápido para heap pequeno.
# TieredStopAtLevel=1 (apenas C1): JIT compila bem mais rápido no cold-start.
ENV JAVA_TOOL_OPTIONS="-Xmx384m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k"

# Vercel injeta a variável PORT em tempo de execução
EXPOSE 8080

# Vercel (Fluid Compute) não herda o ENV PATH da imagem ao invocar o processo.
# Declaramos o PATH explicitamente e usamos o caminho absoluto do java no CMD.
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN addgroup --system app && adduser --system --ingroup app app
USER app

CMD ["sh", "-c", "exec ${JAVA_HOME}/bin/java -jar app.jar"]
